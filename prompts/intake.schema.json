{
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "urgency", "duplicate", "size", "questions", "requester_message"],
  "properties": {
    "outcome": {"type": "string"},
    "urgency": {"type": "object", "additionalProperties": false, "required": ["claim", "evidence", "assessment"],
      "properties": {"claim": {"type": "string"}, "evidence": {"type": "string"}, "assessment": {"type": "string"}}},
    "duplicate": {"type": "object", "additionalProperties": false, "required": ["is_duplicate", "of_issue", "why"],
      "properties": {"is_duplicate": {"type": "boolean"}, "of_issue": {"type": ["integer", "null"]}, "why": {"type": "string"}}},
    "size": {"type": "object", "additionalProperties": false, "required": ["band", "confidence", "risk"],
      "properties": {"band": {"type": "string", "enum": ["S", "M", "L", "XL"]},
                     "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                     "risk": {"type": "string"}}},
    "questions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["text", "owner"],
      "properties": {"text": {"type": "string"}, "owner": {"type": "string", "enum": ["requester", "design", "engineering"]}}}},
    "requester_message": {"type": "string"}
  }
}
